# Normalize line endings to LF in the repository and the working tree.
* text=auto eol=lf

# Binary files.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.ttf binary
*.woff2 binary

# Development files, excluded from `git archive` (the release zip).
# Add here any other file or folder that is not part of the plugin.
/.gitattributes  export-ignore
/.gitignore      export-ignore
/.claude         export-ignore
/.github         export-ignore
/guppy           export-ignore
/AGENTS.md       export-ignore
/CLAUDE.md       export-ignore
/HANDOFF.md      export-ignore
/README.md       export-ignore
/docs            export-ignore
/blueprint.json  export-ignore
/sandbox         export-ignore
/composer.json   export-ignore
/composer.lock   export-ignore
/phpcs.xml.dist  export-ignore
/assets          export-ignore
/assets-src      export-ignore
/src             export-ignore
/tools           export-ignore
/tests           export-ignore
/package.json    export-ignore
/package-lock.json export-ignore
