{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "CampTix Badge Designer demo",
		"author": "nilovelez",
		"description": "Public demo: the WordCamp sandbox (the real CampTix and CampTix Admin Flags from WordPress/wordcamp.org, with invented tickets, questions, attendees and flags) and the built plugin from the dist branch, with a sample badge design. Everything is downloaded from GitHub; nothing is mounted."
	},
	"landingPage": "/wp-admin/edit.php?post_type=tix_ticket&page=ctbd-badges",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "WordCamp Sandbox"
			}
		},
		{
			"step": "writeFiles",
			"writeToPath": "/wordpress/wp-content/mu-plugins/ctbd-sandbox",
			"filesTree": {
				"resource": "git:directory",
				"url": "https://github.com/nilovelez/camptix-badge-designer",
				"ref": "main",
				"refType": "branch",
				"path": "sandbox"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/ctbd-wordcamp-sandbox.php",
			"data": "<?php\n// Loads the WordCamp sandbox.\nrequire __DIR__ . '/ctbd-sandbox/wordcamp-sandbox.php';\n"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/WordPress/wordcamp.org",
				"ref": "89f80bcbb2c6c1e40397317dc47a942332d427e4",
				"refType": "commit",
				"path": "public_html/wp-content/plugins/camptix"
			},
			"options": {
				"activate": true,
				"targetFolderName": "camptix"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/WordPress/wordcamp.org",
				"ref": "89f80bcbb2c6c1e40397317dc47a942332d427e4",
				"refType": "commit",
				"path": "public_html/wp-content/plugins/camptix-admin-flags"
			},
			"options": {
				"activate": true,
				"targetFolderName": "camptix-admin-flags"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/nilovelez/camptix-badge-designer",
				"ref": "dist",
				"refType": "branch",
				"path": "/"
			},
			"options": {
				"activate": true,
				"targetFolderName": "camptix-badge-designer"
			}
		}
	]
}
