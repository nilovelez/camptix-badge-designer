{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "CampTix Badge Designer - WordCamp sandbox",
		"author": "nilovelez",
		"description": "A site that looks like a WordCamp.org site: the real CampTix from the WordPress/wordcamp.org repo, with invented tickets, questions and attendees (sandbox/wordcamp-sandbox.php). The plugin itself is mounted from the repository, not installed by this blueprint."
	},
	"landingPage": "/wp-admin/edit.php?post_type=tix_ticket&page=ctbd-badges",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": "/wordpress/wp-content/plugins/camptix-badge-designer/sandbox/debug.log",
				"WP_DEBUG_DISPLAY": false,
				"SCRIPT_DEBUG": true
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "WordCamp Sandbox"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/ctbd-wordcamp-sandbox.php",
			"data": "<?php\n// Loads the WordCamp sandbox from the mounted plugin repository.\nrequire WP_CONTENT_DIR . '/plugins/camptix-badge-designer/sandbox/wordcamp-sandbox.php';\n"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/WordPress/wordcamp.org",
				"ref": "254bad3b93a2ef491eb1a6dfd14dd9a836319770",
				"refType": "commit",
				"path": "public_html/wp-content/plugins/camptix"
			},
			"options": {
				"activate": true,
				"targetFolderName": "camptix"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/WordPress/wordcamp.org",
				"ref": "254bad3b93a2ef491eb1a6dfd14dd9a836319770",
				"refType": "commit",
				"path": "public_html/wp-content/plugins/camptix-admin-flags"
			},
			"options": {
				"activate": true,
				"targetFolderName": "camptix-admin-flags"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "camptix-badge-designer/camptix-badge-designer.php"
		}
	]
}
