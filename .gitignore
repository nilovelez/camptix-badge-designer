# Composer and npm dependencies.
/vendor/
node_modules/

# JavaScript build output: run `npm install` and `npm run build`.
/build/

# Test data: CampTix exports contain real attendee emails and names.
# Never commit them. Keep them in /test-data/.
/test-data/
*.csv

# Noto fonts for the JavaScript tests, downloaded by tools/fetch-test-fonts.mjs.
/tests/fonts/

# PHP log of the WordCamp sandbox.
/sandbox/debug.log

# Release zips built with `git archive`.
/*.zip

# Local Claude Code settings.
/.claude/settings.local.json
