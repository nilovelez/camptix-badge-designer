{
	"name": "camptix-badge-designer",
	"version": "0.1.0",
	"description": "Design printed badges for CampTix attendees and get a print-ready PDF, generated in the browser.",
	"author": "Nilo Vélez",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"build": "wp-scripts build editor=./src/editor/index.js && node tools/copy-pdf-worker.mjs",
		"start": "wp-scripts start editor=./src/editor/index.js",
		"lint:js": "wp-scripts lint-js src",
		"test:js": "node --no-warnings tests/js/text-test.mjs",
		"fetch-test-fonts": "node tools/fetch-test-fonts.mjs"
	},
	"devDependencies": {
		"@wordpress/scripts": "^37.0.0",
		"regenerator-runtime": "0.14.1"
	},
	"dependencies": {
		"@pdf-lib/fontkit": "^1.1.1",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/icons": "^19.0.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.4.299",
		"woff2-encoder": "^2.0.0"
	}
}
